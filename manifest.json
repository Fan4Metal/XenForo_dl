{
  "manifest_version": 3,
  "name": "XenForo Thread Image Downloader",
  "short_name": "XF Images",
  "version": "1.0.0",
  "description": "Скачивает все изображения из текущего треда форума на XenForo (все страницы, вложения и встроенные картинки).",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "downloads", "downloads.ui", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Скачать изображения треда",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
